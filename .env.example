# Public base URL used to build the Yahoo OAuth redirect_uri. Leave unset
# locally to fall back to https://doublecheckff.com.
NEXT_PUBLIC_BASE_URL=https://doublecheckff.com

# Yahoo Developer app credentials. Register an app at
# https://developer.yahoo.com/apps/ with the "Fantasy Sports Read" scope and
# the redirect_uri NEXT_PUBLIC_BASE_URL + /api/auth/yahoo/callback.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Random string used to derive the AES key that encrypts Yahoo OAuth tokens
# stored in the user's cookie. 32+ random bytes recommended.
YAHOO_TOKEN_SECRET=

# Upstash Redis credentials for shareable read-only links and durable per-IP
# rate limiting. Used by the /api/share endpoint (writes the league payload),
# /s/[slug] share pages (reads it back), and lib/api/rate-limit.ts (sliding
# windows shared across serverless instances). Provision an Upstash Redis
# store from the Vercel Marketplace and Vercel will inject these
# automatically; locally, copy them from the Vercel project's environment
# settings. Without these, share links won't work and rate limits are
# best-effort (in-memory per server instance), but the rest of the tool
# functions normally. Self-hosters provisioning directly from Upstash can set
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead (the names
# Upstash's docs use) - either complete pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_KV_URL=
KV_REST_API_REDIS_URL=
